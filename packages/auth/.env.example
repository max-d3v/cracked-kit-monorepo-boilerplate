# Auth Package Environment Variables (Better Auth)
# Copy to packages/auth/.env
# Needed when running Better Auth tooling (e.g. the CLI) from this package.
# The app reads the same values from apps/app/.env.local.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-local-secret
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nextjs-boilerplate

# Google OAuth (optional — enabled only when both are set)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
