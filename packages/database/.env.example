# Database Package Environment Variables
# Copy to packages/database/.env
# Used by drizzle-kit (db:push, db:migrate, db:studio) and db:seed.

# Local container from docker-compose.yml (`bun --filter @workspace/database dev`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nextjs-boilerplate
# Hosted example (Neon):
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
