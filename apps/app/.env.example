# App Application Environment Variables
# Copy to apps/app/.env.local
# Next.js only loads env files from this directory, so every package the app
# imports reads its variables from here at runtime.

# =============================================================================
# APP / API URLS (apps/app/keys.ts, packages/rpc, packages/payment, packages/email)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# DATABASE (packages/database) — required
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nextjs-boilerplate

# =============================================================================
# AUTHENTICATION (packages/auth — Better Auth) — required
# =============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-local-secret
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
# Google OAuth (optional — enabled only when both are set)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# STRIPE PAYMENTS (packages/payment) — optional
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE=

# =============================================================================
# SENTRY OBSERVABILITY (packages/observability) — optional
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACE_EXPORTER_URL=
SENTRY_TRACE_EXPORTER_SECRET_KEY=

# =============================================================================
# ANALYTICS (packages/analytics) — optional
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
