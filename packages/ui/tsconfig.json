{
  "extends": "@workspace/typescript-config/react-library.json",
  "noEmit": true,
  // @ts-ignore
    "compilerOptions": {
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "paths": {
      "@workspace/ui/*": ["./src/*"]
    }
  },    
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
