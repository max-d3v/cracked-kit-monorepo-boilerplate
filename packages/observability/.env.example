# Observability Package Environment Variables (Sentry)
# Copy to packages/observability/.env.local
# All optional — Sentry is a no-op when NEXT_PUBLIC_SENTRY_DSN is unset.

NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# OpenTelemetry trace exporter (optional)
SENTRY_TRACE_EXPORTER_URL=
SENTRY_TRACE_EXPORTER_SECRET_KEY=
